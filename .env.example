# Application
APP_ENV=development
LOG_LEVEL=INFO

# Public origin for Retell custom tool webhooks (no trailing slash)
# Example: https://summit-air-xxxx.run.app  or  https://xxxx.ngrok.app
WEBHOOK_BASE_URL=

# Retell / Twilio (secrets — never commit real values)
RETELL_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Email Configuration
# SMTP settings for sending booking notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Summit Air
EMAIL_ENABLED=true
ADMIN_NOTIFICATION_EMAIL=axeldelakowski@gmail.com
