# Application
APP_ENV=development
LOG_LEVEL=INFO

# Public origin for Retell custom tool webhooks (no trailing slash)
# Example: https://summit-air-xxxx.run.app  or  https://xxxx.ngrok.app
WEBHOOK_BASE_URL=

# Technician schedule (John / Paul / George). SQLite file path.
# Local default: data/schedule.db  |  Cloud Run single-instance: /tmp/schedule.db
# Leave empty for in-memory only (not durable).
SCHEDULE_DB_PATH=data/schedule.db

# Retell / Twilio (secrets — never commit real values)
RETELL_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Post-call email summary (appointment + transcript)
SUMMARY_EMAIL_TO=axeldelakowski@gmail.com
SUMMARY_EMAIL_FROM=Summit Air Alex <onboarding@resend.dev>
# Prefer Resend (https://resend.com) — free API key works for testing
RESEND_API_KEY=
# Or SMTP instead of Resend:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
